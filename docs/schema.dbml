Ref: appointments.slot_id > appointment_slots.id
Ref: appointments.user_id > users.id
Ref: appointments.vehicle_id > vehicles.id
Ref: auth_refresh_tokens.session_id > auth_sessions.id
Ref: auth_sessions.user_id > users.id
Ref: offers.service_id > services.id
Ref: package_items.package_id > services.id
Ref: package_items.service_id > services.id
Ref: payments.appointment_id > appointments.id
Ref: services.category_id > service_categories.id
Ref: vehicles.user_id > users.id

