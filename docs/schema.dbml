// Generated from migrated PostgreSQL. SQL migrations remain authoritative.
Enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

Enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

Enum MediaStorageProvider {
  POSTGRESQL
  CLOUDINARY
}

Enum PaymentProvider {
  SSLCOMMERZ
}

Enum PaymentStatus {
  INITIATING
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REVIEW_REQUIRED
}

Enum ServiceType {
  INDIVIDUAL
  PACKAGE
}

Enum UserRole {
  CUSTOMER
  ADMIN
}

Enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

Table appointment_slots {
  id uuid [pk, not null]
  service_id uuid [not null]
  bay_id uuid [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  is_active boolean [not null]
  created_at timestamptz [not null]
}

Table appointments {
  id uuid [pk, not null]
  user_id uuid [not null]
  service_id uuid [not null]
  slot_id uuid [not null]
  vehicle_id uuid
  bay_id uuid [not null]
  status AppointmentStatus [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  service_name text [not null]
  base_price decimal(12,2) [not null]
  price decimal(12,2) [not null]
  currency varchar(3) [not null]
  duration_minutes integer [not null]
  applied_offer_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  cancelled_at timestamptz
}

Table auth_refresh_tokens {
  digest varchar(64) [pk, not null]
  session_id uuid [not null]
  created_at timestamptz [not null]
  used_at timestamptz
}

Table auth_sessions {
  id uuid [pk, not null]
  user_id uuid [not null]
  refresh_token_digest varchar(64) [unique, not null]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null]
  rotated_at timestamptz
  last_seen_at timestamptz
  ip_address varchar(45)
  user_agent varchar(512)
}

Table business_hours {
  id uuid [pk, not null]
  day_of_week integer [not null]
  opens_at varchar(5) [not null]
  closes_at varchar(5) [not null]
  is_closed boolean [not null]
}

Table media_assets {
  id uuid [pk, not null]
  data bytea
  mime_type text [not null]
  file_size integer [not null]
  created_at timestamptz [not null]
  storage_provider MediaStorageProvider [not null]
  cloudinary_public_id text [unique]
  cloudinary_secure_url text
}

Table offers {
  id uuid [pk, not null]
  service_id uuid [not null]
  title text [not null]
  description text [not null]
  discount_type DiscountType [not null]
  discount_value decimal(12,2) [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  is_active boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table package_items {
  package_id uuid [not null]
  service_id uuid [not null]
  quantity integer [not null]
  indexes {
    (package_id, service_id) [pk]
  }
}

Table payments {
  id uuid [pk, not null]
  appointment_id uuid [not null]
  provider PaymentProvider [not null]
  merchant_transaction_id varchar(30) [unique, not null]
  amount decimal(12,2) [not null]
  currency varchar(3) [not null]
  status PaymentStatus [not null]
  session_key text
  checkout_url text
  validation_id varchar(50) [unique]
  bank_transaction_id varchar(80) [unique]
  failure_reason text
  paid_at timestamptz
  applied boolean [not null]
  gateway_incidents jsonb [not null]
  last_reconciled_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table platform_settings {
  key text [pk, not null]
  value jsonb [not null]
  updated_at timestamptz [not null]
}

Table service_bays {
  id uuid [pk, not null]
  name text [unique, not null]
  is_active boolean [not null]
}

Table service_categories {
  id uuid [pk, not null]
  name text [not null]
  slug text [unique, not null]
  description text
  image_url text
  is_active boolean [not null]
  sort_order integer [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table services {
  id uuid [pk, not null]
  category_id uuid [not null]
  type ServiceType [not null]
  name text [not null]
  slug text [unique, not null]
  description text [not null]
  price decimal(12,2) [not null]
  currency varchar(3) [not null]
  duration_minutes integer [not null]
  image_url text
  inclusions text[]
  is_active boolean [not null]
  is_featured boolean [not null]
  sort_order integer [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table users {
  id uuid [pk, not null]
  name varchar(160) [not null]
  email varchar(320) [unique, not null]
  password_hash text [not null]
  status UserStatus [not null]
  last_login_at timestamptz
  password_changed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  role UserRole [not null]
}

Table vehicles {
  id uuid [pk, not null]
  user_id uuid [not null]
  make text [not null]
  model text [not null]
  year integer
  registration_number text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Ref: appointment_slots.bay_id > service_bays.id
Ref: appointment_slots.service_id > services.id
Ref: appointments.applied_offer_id > offers.id
