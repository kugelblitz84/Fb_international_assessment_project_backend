enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
model Appointment {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  slotId String @map("slot_id") @db.Uuid
  vehicleId String? @map("vehicle_id") @db.Uuid
  bayId String @map("bay_id") @db.Uuid
  status AppointmentStatus @default(PENDING)
  startsAt DateTime @map("starts_at") @db.Timestamptz
  endsAt DateTime @map("ends_at") @db.Timestamptz
  serviceName String @map("service_name")
  basePrice Decimal @map("base_price") @db.Decimal(12,2)
  price Decimal @db.Decimal(12,2)
  currency String @db.VarChar(3)
  durationMinutes Int @map("duration_minutes")
  appliedOfferId String? @map("applied_offer_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  slot AppointmentSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  bay ServiceBay @relation(fields: [bayId], references: [id], onDelete: Restrict)
  appliedOffer Offer? @relation(fields: [appliedOfferId], references: [id], onDelete: Restrict)
  @@index([userId, startsAt])
  @@index([serviceId])
  @@index([slotId])
  @@index([vehicleId])
  @@index([appliedOfferId])
  @@map("appointments")
}
