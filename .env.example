NODE_ENV=development
PORT=3000

# Supply an existing local PostgreSQL database and your own credentials.
DATABASE_URL=postgresql://autocare:replace-with-local-password@localhost:5432/autocare

# Exact browser origins, comma-separated, without trailing slashes. Empty disables
# cross-origin browser access; native Flutter does not require a CORS origin.
CORS_ORIGINS=http://localhost:5173
HTTP_BODY_LIMIT_BYTES=65536

# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_ACCESS_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_ISSUER=autocare
AUTH_AUDIENCE=autocare-api
AUTH_COOKIE_SAME_SITE=lax
# Use true with HTTPS; required in production and for SameSite=None.
AUTH_COOKIE_SECURE=false
BOOKING_HORIZON_DAYS=30
BOOKING_SLOT_STEP_MINUTES=15
# Optional: dedicated disposable database for npm run test:integration.
TEST_DATABASE_URL=
