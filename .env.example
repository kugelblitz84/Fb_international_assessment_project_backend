NODE_ENV=development
PORT=3000

# Supply an existing local PostgreSQL database and your own credentials.
DATABASE_URL=postgresql://autocare:replace-with-local-password@localhost:5432/autocare

# Exact browser origins, comma-separated, without trailing slashes. Empty disables
# cross-origin browser access; native Flutter does not require a CORS origin.
CORS_ORIGINS=http://localhost:5173
HTTP_BODY_LIMIT_BYTES=65536

# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_ACCESS_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_ISSUER=autocare
AUTH_AUDIENCE=autocare-api
AUTH_COOKIE_SAME_SITE=lax
# Use true with HTTPS; required in production and for SameSite=None.
AUTH_COOKIE_SECURE=false
BOOKING_HORIZON_DAYS=30
BOOKING_SLOT_STEP_MINUTES=15
# Optional: dedicated disposable database for npm run test:integration.
TEST_DATABASE_URL=

# Optional Gemini assistant. Blank key disables only the assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_OUTPUT_TOKENS=1500
ASSISTANT_REQUESTS_PER_MINUTE=5
ASSISTANT_REQUESTS_PER_HOUR=20
# Shared PostgreSQL daily cap; set at/below the project's actual quota, or 0 to disable usage.
ASSISTANT_DAILY_REQUEST_BUDGET=100
ASSISTANT_MAX_CONCURRENT=2

# Externally reachable API root including /api/v1. Required for online checkout.
# Production must use HTTPS; never derived from request Host.
PUBLIC_API_BASE_URL=

# Optional Cloudinary: supply all three credentials together, server-side only.
# Missing credentials disable new uploads; existing/seeded images remain available.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=autocare

# Optional SSLCOMMERZ: use sandbox credentials first. Supply both or neither.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_TIMEOUT_MS=20000

# Empty means no forwarded-header trust. Set only verified ingress proxy IPs/CIDRs.
# Never use a blanket subnet unless it is your actual controlled proxy network.
TRUSTED_PROXY_ADDRESSES=
